{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Add Plex": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Plex"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 Plex"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plexを追加"
          }
        }
      }
    },
    "Authorize Krill in your browser. Your Plex password is never entered in Krill.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中授权 Krill。无需在 Krill 中输入 Plex 密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器中授權 Krill。無需在 Krill 中輸入 Plex 密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでKrillを認証します。PlexのパスワードはKrillに入力しません。"
          }
        }
      }
    },
    "Couldn't access the saved Plex session. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't access the saved Plex session. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的 Plex 会话。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取已儲存的 Plex 工作階段。請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した Plex セッションにアクセスできません。再試行してください。"
          }
        }
      }
    },
    "Couldn't connect to Plex. Check the server and your network.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect to Plex. Check the server and your network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Plex。请检查服务器和网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接 Plex。請檢查伺服器和網路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plex に接続できません。サーバーとネットワークを確認してください。"
          }
        }
      }
    }
  }
}
